rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Whitelisted Admin Check Helper Function
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == "vuggidisaivarshith@gmail.com" ||
        request.auth.token.email.lower() == "maruthisaiteja9@gmail.com" ||
        request.auth.token.email.lower() == "swethabharath27@vardhaman.org" ||
        request.auth.token.email.lower() == "pollishetty.swetha@vardhaman.org"
      );
    }

    // Contact messages: anyone can create, only whitelisted admin can read/update/delete
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // All other collections (events, team, gallery, announcements, achievements, resources, siteSettings)
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
