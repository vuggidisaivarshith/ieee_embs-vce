rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == "vuggidisaivarshith@gmail.com" ||
        request.auth.token.email.lower() == "maruthisaiteja9@gmail.com" ||
        request.auth.token.email.lower() == "swethabharath27@vardhaman.org" ||
        request.auth.token.email.lower() == "pollishetty.swetha@vardhaman.org"
      );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
